#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "Base";
            bindings = <
&kp A  &kp B  &kp C  &kp D  &kp E  &kp F  &kp G  &kp H  &kp I  &kp J  &kp K  &kp L
&kp M  &kp N  &kp O  &kp P  &kp Q  &kp R  &kp S  &kp T  &kp U  &kp V  &kp W  &kp X
&kp Y  &kp Z  &kp A  &kp B  &kp C  &kp D  &kp E  &kp F  &kp G  &kp H  &kp I  &kp J

                     &kp K  &kp L  &kp M  &kp N  &kp O
            >;
        };

        Number {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp N7         &kp N8           &kp N9         &kp N0  &trans
&trans  &trans        &trans        &trans        &trans        &trans  &kp PLUS      &kp MINUS      &kp KP_MULTIPLY  &kp KP_DIVIDE  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans  &trans        &trans         &trans           &trans         &trans  &trans

                                    &trans        &trans        &trans  &kp KP_EQUAL  &kp BACKSPACE
            >;
        };
    };
};
